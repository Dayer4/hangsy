# Copy to .env. Both sections are optional — the app works without them,
# just with reduced functionality (see the comment on each).

# From Google Cloud Console (see chat history for setup steps). Without this,
# the login page shows a disabled "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=

# Optional — free Cloudinary account (cloudinary.com), "unsigned" upload
# preset (Settings > Upload in their dashboard). Without these, the New
# Hangout form falls back to a paste-a-URL field for the cover image instead
# of a real file picker. Free tier: ~25 monthly credits (roughly 25GB
# storage+bandwidth combined) — plenty for a personal project.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

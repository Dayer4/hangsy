# Copy this file to .env and fill in real values. Never commit the real .env.

DATABASE_URL=postgresql://user:password@localhost:5432/hangsy

# Used to sign JWT login tokens (app/utils/security.py). Any long random
# string works — e.g. generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-real-random-secret

# From Google Cloud Console > APIs & Services > Credentials (OAuth client ID,
# type "Web application"). Needed for POST /auth/google. See chat for setup steps.
GOOGLE_CLIENT_ID=

# Needed only for Google Calendar sync (not Sign-In) — same OAuth client as
# above, but grab its "Client secret" too (same Credentials page). Also add
# http://localhost:8000/calendar/callback as an Authorized redirect URI on
# that client (Sign-In doesn't need one; this does).
GOOGLE_CLIENT_SECRET=

# Used to build the Calendar OAuth redirect URI. Change if the backend runs
# somewhere other than localhost:8000.
BACKEND_URL=http://localhost:8000

# Optional — without this, verification emails just print to the backend's
# console instead of actually sending (fine for local dev). Get a free key
# at resend.com once you want real emails to go out.
RESEND_API_KEY=
EMAIL_FROM=Hangsy <onboarding@resend.dev>

# Used to build the link inside verification emails.
FRONTEND_URL=http://localhost:5173

# Optional — from kroger.com/developer (free developer account). Without
# these, GET /items/suggest returns 501 instead of pretending to work.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Comma-separated list of frontend origins allowed to call this API.
# Defaults to the Vite dev server if unset.
CORS_ORIGINS=http://localhost:5173

# Optional: point pytest at a separate database so tests never touch dev data.
# Falls back to DATABASE_URL above if unset.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/hangsy_test

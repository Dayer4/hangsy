# Copy this file to .env and fill in real values. Never commit the real .env.

DATABASE_URL=postgresql://user:password@localhost:5432/hangsy

# Used to sign JWT login tokens (app/utils/security.py). Any long random
# string works — e.g. generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-real-random-secret

# From Google Cloud Console > APIs & Services > Credentials (OAuth client ID,
# type "Web application"). Needed for POST /auth/google. See chat for setup steps.
GOOGLE_CLIENT_ID=

# Optional: point pytest at a separate database so tests never touch dev data.
# Falls back to DATABASE_URL above if unset.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/hangsy_test
